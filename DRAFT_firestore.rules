rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidStore(data) {
      return data.keys().hasAll(['name', 'categoryId', 'areaId', 'address', 'creatorId', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 8 // Including optional mapLink
        && data.name is string && data.name.size() <= 50
        && data.address is string && data.address.size() <= 100
        && data.categoryId is string
        && data.areaId is string
        && data.creatorId == request.auth.uid
        && (data.mapLink == null || data.mapLink is string);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.keys().size() == 2
        && data.name is string && data.name.size() <= 30;
    }

    function isValidArea(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.keys().size() == 2
        && data.name is string && data.name.size() <= 30;
    }

    // --- Rules ---

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(storeId) && isValidStore(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
        && existing().creatorId == request.auth.uid
        && isValidStore(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isSignedIn();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(areaId) && isValidArea(incoming());
      allow delete: if isSignedIn();
    }
  }
}
