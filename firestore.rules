rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidStore(data) {
      return data.name is string && data.name.size() <= 100
        && data.address is string && data.address.size() <= 250
        && data.categoryIds is list && data.categoryIds.size() > 0
        && data.areaId is string
        && (data.creatorId == null || data.creatorId is string)
        && (data.mapLink == null || data.mapLink is string)
        && (data.categoryId == null || data.categoryId is string);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'createdAt', 'order'])
        && data.keys().size() == 3
        && data.name is string && data.name.size() <= 30
        && data.order is int;
    }

    function isValidArea(data) {
      return data.keys().hasAll(['name', 'createdAt', 'order'])
        && data.keys().size() == 3
        && data.name is string && data.name.size() <= 30
        && data.order is int;
    }

    // --- Rules ---

    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidCategory(incoming());
      allow delete: if isSignedIn();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidArea(incoming());
      allow delete: if isSignedIn();
    }
  }
}
